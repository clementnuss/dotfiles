;; home-row mods; the key-timing switch skips them while typing fast (3rd most recent key < 250ms ago)
(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold   yes

  ;; whitelist, not exclude: an exclude list leaked onto the Kyria and the MX Keys
  linux-dev-names-include ("AT Translated Set 2 keyboard")
)

(defsrc
  esc    f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
  grv    1     2     3     4     5     6     7     8     9     0     -     =     bspc
  tab    q     w     e     r     t     y     u     i     o     p     [     ]
  caps   a     s     d     f     g     h     j     k     l     ;     '     \     ret
  lsft < z     x     c     v     b     n     m     ,     .     /     rsft
        lctl  lalt  lmet              spc               rmet  ralt  ◀    ▲ ▼    ▶
)

(deftemplate charmod (char mod)
  (switch
    ((key-timing 3 less-than 250)) $char break
    () (tap-hold-release-timeout 200 500 $char $mod $char) break
  )
)

(deflayermap (main)
  a (t! charmod a lctl)
  s (t! charmod s lalt)
  d (t! charmod d lmet)
  f (t! charmod f lsft)
  j (t! charmod j lsft)
  k (t! charmod k lmet)
  l (t! charmod l lalt)
  ; (t! charmod ; lctl)
)
