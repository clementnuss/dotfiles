[Unit]
# supervised: the package ships no Linux autostart; leave the in-app login toggle off (AGENTS.md)
Description=drata-agent (Drata compliance agent)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/drata-agent
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
