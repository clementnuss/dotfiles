#!/usr/bin/env bash
# ~/.config/sketchybar/sketchybarrc
# Catppuccin Latte color scheme + AeroSpace workspace integration

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ── Catppuccin Latte palette ──────────────────────────────────────────────────
# base:    0xffeff1f5   mantle:  0xffe6e9ef   surface0: 0xffccd0da
# text:    0xff4c4f69   subtext: 0xff6c6f85   overlay:  0xff7c7f93
# lavender:0xff7287fd   blue:    0xff1e66f5   pink:     0xffea76cb
# green:   0xff40a02b   yellow:  0xffdf8e1d   red:      0xffd20f39
# mauve:   0xff8839ef

# ── Bar appearance ────────────────────────────────────────────────────────────
sketchybar --bar \
    position=top          \
    height=36             \
    margin=8              \
    y_offset=4            \
    corner_radius=10      \
    blur_radius=1        \
    color=0xcceff1f5      \
    border_width=1        \
    border_color=0x444c4f69 \
    shadow=on             \
    topmost=window        \
    padding_left=12       \
    padding_right=12

# ── Global item defaults ──────────────────────────────────────────────────────
sketchybar --default \
    padding_left=4                              \
    padding_right=4                             \
    icon.font="JetBrainsMono Nerd Font:Bold:15.0" \
    label.font="JetBrainsMono Nerd Font:Bold:13.0" \
    icon.color=0xff4c4f69                       \
    label.color=0xff4c4f69                       \
    icon.padding_left=6                         \
    icon.padding_right=4                         \
    label.padding_left=4                         \
    label.padding_right=6

# ── LEFT: AeroSpace workspace indicators ───────────────────────────────────────
sketchybar --add event aerospace_workspace_change

COLOR=0xff1e66f5
for sid in $(seq 1 9); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
            background.color=0x00000000              \
            background.corner_radius=6               \
            background.height=24                     \
            background.drawing=off                   \
            label="$sid"                             \
            label.font="JetBrainsMono Nerd Font:Bold:12.0" \
            label.color=$COLOR                       \
            icon.drawing=off                         \
            padding_left=3                           \
            padding_right=3                          \
            click_script="aerospace workspace $sid"  \
            script="$PLUGIN_DIR/aerospace.sh $sid $COLOR"
done

# Group workspace items under a shared background pill
sketchybar --add bracket workspaces '/space\..*/' \
    --set workspaces \
        background.color=0x44ccd0da     \
        background.corner_radius=8      \
        background.height=28            \
        background.border_width=1       \
        background.border_color=0x334c4f69

# ── LEFT: Frontmost app name ──────────────────────────────────────────────────
sketchybar --add item front_app left \
    --set front_app \
        icon.drawing=off                                    \
        label.font="JetBrainsMono Nerd Font:Bold:13.0"     \
        label.color=0xff6c6f85                              \
        padding_left=10                                     \
        script="$PLUGIN_DIR/front_app.sh"                   \
    --subscribe front_app front_app_switched

# ── RIGHT: Clock ──────────────────────────────────────────────────────────────
sketchybar --add item clock right \
    --set clock \
        icon=""                     \
        icon.color=0xff1e66f5       \
        icon.padding_left=0         \
        label.color=0xff4c4f69      \
        padding_left=4              \
        padding_right=4             \
        update_freq=10              \
        script="$PLUGIN_DIR/clock.sh"

# ── RIGHT: Battery ────────────────────────────────────────────────────────────
sketchybar --add item battery right \
    --set battery \
        label.color=0xff4c4f69      \
        update_freq=120             \
        script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change

# ── RIGHT: Volume ─────────────────────────────────────────────────────────────
sketchybar --add item volume right \
    --set volume \
        label.color=0xff4c4f69      \
        script="$PLUGIN_DIR/volume.sh" \
    --subscribe volume volume_change

# ── RIGHT: CPU ────────────────────────────────────────────────────────────────
sketchybar --add item cpu right \
    --set cpu \
        icon="󰻠"                   \
        icon.font="JetBrainsMono Nerd Font:Bold:15.0" \
        icon.color=0xff40a02b       \
        label.color=0xff4c4f69      \
        update_freq=10              \
        script="$PLUGIN_DIR/cpu.sh"

# ── RIGHT: Memory ─────────────────────────────────────────────────────────────
sketchybar --add item memory right \
    --set memory \
        label.color=0xff4c4f69      \
        update_freq=10              \
        script="$PLUGIN_DIR/memory.sh"

# ── Trigger initial update ────────────────────────────────────────────────────
sketchybar --update
