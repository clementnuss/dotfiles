# Curated: the first Server supplies the sync DB, so it must be fresh (unattended-update checks its lastsync).
# geo.mirror.pkgbuild.com is Arch-run GeoDNS; the CH mirrors were fresh on 2026-11-22.
# Dropped: mirror.metanet.ch (6 days stale + HTTP/2 resets), mirror.ungleich.ch (lagging).
# Freshness per mirror: https://archlinux.org/mirrors/status/
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.init7.net/archlinux/$repo/os/$arch
Server = https://mirror.puzzle.ch/archlinux/$repo/os/$arch
Server = https://theswissbay.ch/archlinux/$repo/os/$arch
Server = https://ch.mirrors.cicku.me/archlinux/$repo/os/$arch
Server = https://mirror.arch-linux.ch/archlinux/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
