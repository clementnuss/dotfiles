[Unit]
# exit 1 = detections (unit "fails" by design), exit 2 = error; excludes live in clamd.conf
Description=clamav weekly scan (Drata evidence; AC-only)
ConditionACPower=true
OnFailure=clamav-notify.service

[Service]
Type=oneshot
ExecStart=/usr/bin/clamdscan --multiscan --fdpass /
Nice=19
IOSchedulingClass=idle
