#!/bin/sh
# follow clamonacc's journal; toast every FOUND line on each session bus via runuser

journalctl -fu clamav-clamonacc.service -n0 -o cat | while IFS= read -r line; do
    case "$line" in
        *FOUND*) ;;
        *) continue ;;
    esac
    for BUS in /run/user/*/bus; do
        [ -S "$BUS" ] || continue
        UID_NUM=${BUS#/run/user/}; UID_NUM=${UID_NUM%/bus}
        USER_NAME=$(getent passwd "$UID_NUM" | cut -d: -f1)
        [ -n "$USER_NAME" ] || continue
        runuser -u "$USER_NAME" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS" \
            notify-send -u critical -i dialog-warning "Antivirus: file flagged" "$line"
    done
done
