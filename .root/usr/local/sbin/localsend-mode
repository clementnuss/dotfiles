#!/bin/sh
# localsend-mode home|open|blocked|status: rewrite the localsend_nets set in the running ruleset.
#   home    192.168.0.0/16 (file default; any 192.168.x.x network counts)
#   open    0.0.0.0/0, auto-reverts to home after 45min (rely on LocalSend's PIN)
#   blocked empty set; the device stays discoverable
# A reload or boot resets to /etc/nftables.conf.

[ "$(id -u)" -eq 0 ] || { echo 'must run as root: sudo localsend-mode <home|open|blocked|status>'; exit 1; }

HOME_NET=192.168.0.0/16
AUTO_OFF=45min

notify() { # $1 = body — desktop toast via the user session bus
    for BUS in /run/user/*/bus; do
        [ -S "$BUS" ] || continue
        U=${BUS#/run/user/}; U=${U%/bus}
        NAME=$(getent passwd "$U" | cut -d: -f1)
        [ -n "$NAME" ] || continue
        runuser -u "$NAME" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS" \
            notify-send -u normal -i localsend "$1"
    done
}

set_mode() { # $1 = element spec ('{ ... }'), empty = blocked (no add)
    nft flush set inet filter localsend_nets
    [ -n "$1" ] && nft add element inet filter localsend_nets "$1"
}

case "$1" in
status)
    RULES=$(nft list set inet filter localsend_nets 2>/dev/null)
    if printf '%s' "$RULES" | grep -q '0\.0\.0\.0/0'; then
        echo "localsend inbound: OPEN (any network; auto-reverts home)"
    elif printf '%s' "$RULES" | grep -q '[0-9]/'; then
        echo "localsend inbound: home LAN ($HOME_NET)"
    else
        echo "localsend inbound: BLOCKED (transfers closed; device still discoverable)"
    fi
    ;;
open)
    systemctl stop localsend-auto-off.timer 2>/dev/null   # re-open reschedules
    set_mode '{ 0.0.0.0/0 }'
    systemd-run --unit=localsend-auto-off --on-active=$AUTO_OFF --collect \
        /usr/local/sbin/localsend-mode home
    notify "LocalSend: open on this network — auto-closes in 45 min"
    ;;
home)
    set_mode "{ $HOME_NET }"
    notify "LocalSend: inbound back to home LAN (192.168/16)"
    ;;
blocked)
    set_mode ""
    notify "LocalSend: inbound blocked"
    ;;
*)
    echo "usage: sudo localsend-mode <home|open|blocked|status>" >&2
    exit 1
    ;;
esac
