#!/bin/sh
# clamav-scan OnFailure hook: count FOUND lines (48h window) and toast every session bus via runuser

FOUND=$(journalctl -u clamav-scan.service --since "-48h" --no-pager | grep -c " FOUND")

if [ "$FOUND" -gt 0 ]; then
    TITLE="Antivirus: ${FOUND} detection(s)"
    BODY="ClamAV weekly scan found something - see: journalctl -u clamav-scan"
else
    TITLE="Antivirus scan failed"
    BODY="No detections, but the scan errored - see: journalctl -u clamav-scan"
fi

for BUS in /run/user/*/bus; do
    [ -S "$BUS" ] || continue
    UID_NUM=${BUS#/run/user/}; UID_NUM=${UID_NUM%/bus}
    USER_NAME=$(getent passwd "$UID_NUM" | cut -d: -f1)
    [ -n "$USER_NAME" ] || continue
    runuser -u "$USER_NAME" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS" \
        notify-send -u critical -i dialog-warning "$TITLE" "$BODY"
done
