[user]
	name = Clément Nussbaumer
	signingkey = A99C6A4E3C856DA9
	email = {{ .email }}
[commit]
	gpgsign = true
[pull]
	rebase = false
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[ghq]
	root = ~/git
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only --features=interactive
[diff]
	colorMoved = default
[delta]
	features = decorations
	light = true
[delta "interactive"]
	keep-plus-minus-markers = false
[delta "decorations"]
	commit-decoration-style = blue ol
	commit-style = raw
	file-style = omit
	hunk-header-decoration-style = blue box
	hunk-header-file-style = red
	hunk-header-line-number-style = "#067a00"
	hunk-header-style = file line-number syntax
[credential]
	helper = cache --timeout=86400
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# keep last so the work identity wins
[includeIf "gitdir:~/git/github.com/VictoriaMetrics/"]
	path = ~/.config/git/victoriametrics
[includeIf "gitdir:~/git/github.com/clementnuss/worklog-vm/"]
	path = ~/.config/git/victoriametrics
