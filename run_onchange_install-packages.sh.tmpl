#!/bin/bash
set -euo pipefail

# lists live in .chezmoidata/packages.yaml; editing them changes this rendered script, so apply re-runs it
{{- $groups := list }}
{{- range $name, $g := .packages }}
{{-   if or (not (hasKey $g "profiles")) (has $.profile $g.profiles) }}
{{-     $groups = append $groups $g }}
{{-   end }}
{{- end }}

OFFICIAL_PACKAGES=(
{{- range $groups }}{{ range dig "official" list . }}
    {{ . }}
{{- end }}{{ end }}
)

AUR_PACKAGES=(
{{- range $groups }}{{ range dig "aur" list . }}
    {{ . }}
{{- end }}{{ end }}
)

sudo pacman -S --needed --noconfirm "${OFFICIAL_PACKAGES[@]}"
# the list is the source of truth for install reason: a listed package must never turn up as an orphan
sudo pacman -D --asexplicit --quiet "${OFFICIAL_PACKAGES[@]}" >/dev/null

# kernel-modules-hook: prunes the kept modules of old kernels after reboot
sudo systemctl enable linux-modules-cleanup.service

if command -v yay >/dev/null; then
    yay -S --needed --noconfirm "${AUR_PACKAGES[@]}"
    sudo pacman -D --asexplicit --quiet "${AUR_PACKAGES[@]}" >/dev/null
else
    echo "yay not found: skipping AUR packages" >&2
fi

# cliphist master build for `list -fields` (cliphist-redact --min-age);
# drop this and ~/.local/bin/cliphist-next once the distro cliphist has it
if command -v go >/dev/null && [ ! -x "$HOME/.local/bin/cliphist-next" ]; then
    GOBIN="$HOME/.local/bin" go install go.senan.xyz/cliphist@f968c4f01395860e8c989c550c1621124927890f \
        && mv "$HOME/.local/bin/cliphist" "$HOME/.local/bin/cliphist-next" \
        || echo "cliphist-next build failed" >&2
fi
