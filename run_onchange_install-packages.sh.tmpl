#!/bin/bash
set -euo pipefail

OFFICIAL_PACKAGES=(
    7zip
    atuin
    bluez
    bluez-utils
    brightnessctl
    btop
    chezmoi
    chromium
    clamav
    cliphist
    cups
    ddcutil
    dog
    ffmpeg
    fluxcd
    fuse-overlayfs
    fuzzel
    fzf
    ghostscript
    ghostty
    ghq
    git-delta
    git-lfs
    go
    go-task
    gpg-tui
    gpu-screen-recorder
    grim
    gsfonts
    hypridle
    hyprland
    hyprlock
    hyprpolkitagent
    jq
    k9s
    kubectl
    lazygit
    neovim
    networkmanager
    nftables
    nodejs
    noto-fonts-emoji
    npm
    pacman-contrib
    pipewire
    pipewire-alsa
    pipewire-audio
    pipewire-pulse
    pnpm
    podman
    podman-docker
    power-profiles-daemon
    pulsemixer
    python-gobject
    rbw
    rclone
    rofimoji
    sane-airscan
    satty
    simple-scan
    slurp
    snap-pac
    snapper
    sof-firmware
    sops
    starship
    swaybg
    talosctl
    tmux
    ttf-jetbrains-mono-nerd
    udiskie
    udisks2
    uwsm
    wireguard-tools
    wireplumber
    wl-clipboard
    wtype
    xdg-terminal-exec
    yazi
    zoxide
    zsh
)

AUR_PACKAGES=(
    caligula-bin
    ddcutil-service
{{- if eq .profile "work" }}
    drata-agent
{{- end }}
    hyprmoncfg
    kanata-bin
    kind
    kopia-bin
    localsend
    omni-launcher
    omni-shell
    seadrive-gui
    vial-appimage
    wifitui
)

sudo pacman -S --needed --noconfirm "${OFFICIAL_PACKAGES[@]}"

if command -v yay >/dev/null; then
    yay -S --needed --noconfirm "${AUR_PACKAGES[@]}"
else
    echo "yay not found: skipping AUR packages" >&2
fi

# cliphist master build for `list -fields` (cliphist-redact --min-age);
# drop this and ~/.local/bin/cliphist-next once the distro cliphist has it
if command -v go >/dev/null && [ ! -x "$HOME/.local/bin/cliphist-next" ]; then
    GOBIN="$HOME/.local/bin" go install go.senan.xyz/cliphist@f968c4f01395860e8c989c550c1621124927890f \
        && mv "$HOME/.local/bin/cliphist" "$HOME/.local/bin/cliphist-next" \
        || echo "cliphist-next build failed" >&2
fi
