#!/usr/bin/env bash
# preset the GPG passphrase from rbw into gpg-agent (RAM only)
set -euo pipefail

rbw_entry="GPG-key-2025"
preset="$(gpgconf --list-dirs libexecdir)/gpg-preset-passphrase"

mapfile -t grips < <(gpg-connect-agent 'keyinfo --list' /bye \
  | awk '$1 == "S" && $8 == "P" { print $3 }')

if [ ${#grips[@]} -eq 0 ]; then
  echo "gpg-unlock: no protected secret keys found in the agent" >&2
  exit 1
fi

passphrase="$(rbw get "$rbw_entry")"

for grip in "${grips[@]}"; do
  printf '%s\n' "$passphrase" | "$preset" --preset "$grip"
  echo "unlocked keygrip ${grip:0:16}…"
done
