#!/usr/bin/env bash
set -euo pipefail

KANATA_PORT=5829

usage() {
  echo "Usage: kanata-switch <laptop|splitkb>" >&2
  exit 1
}

case "${1:-}" in
  laptop)  layer="main" ;;
  splitkb) layer="split" ;;
  *)       usage ;;
esac

msg=$(printf '{"ChangeLayer":{"new":"%s"}}\n' "$layer")
if ! echo "$msg" | nc -w1 127.0.0.1 "$KANATA_PORT"; then
  echo "Error: could not reach kanata on port $KANATA_PORT" >&2
  exit 1
fi

echo "Switched to kanata layer: $layer"
