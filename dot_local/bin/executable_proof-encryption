#!/bin/sh
# Drata evidence: LUKS, transcript-style. No set -e: show failures too.

printf '========== LUKS / Drata evidence — %s ==========\n' "$(hostname)"

printf '$ date\n'; date

LUKS_DEV=$(lsblk -rnpo NAME,TYPE,FSTYPE | awk '$3 == "crypto_LUKS" { print $1; exit }')
if [ -z "$LUKS_DEV" ]; then
    echo '!! no crypto_LUKS partition found on this machine'
    printf '===========================================================\n'
    exit 1
fi

printf '$ lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS\n'
lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS

printf '$ sudo cryptsetup luksDump %s\n' "$LUKS_DEV"
sudo cryptsetup luksDump "$LUKS_DEV"

LUKS_MAP=$(lsblk -rno NAME,PKNAME | awk -v d="${LUKS_DEV##*/}" '$2 == d { print $1; exit }')
if [ -n "$LUKS_MAP" ]; then
    printf '$ sudo cryptsetup status %s\n' "$LUKS_MAP"
    sudo cryptsetup status "$LUKS_MAP"
else
    echo '!! no active mapping found (volume not unlocked?)'
fi

printf '===========================================================\n'
