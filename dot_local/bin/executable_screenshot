#!/bin/bash
# screenshot [region|window|all]: file + clipboard + toast (click = satty). Re-press cancels.

set -u
DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"

pkill -x slurp && exit 0

mode="${1:-region}"
FILE="$DIR/screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

case "$mode" in
    region)
        geom=$(slurp) || exit 0
        [ -n "$geom" ] || exit 0
        grim -g "$geom" "$FILE" || exit 1
        ;;
    window)
        geom=$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0]) \(.size[1])"') || exit 1
        [ -n "$geom" ] && [ "$geom" != "null" ] || exit 1
        grim -g "$geom" "$FILE" || exit 1
        ;;
    all)
        grim "$FILE" || exit 1
        ;;
    *)
        echo "usage: screenshot [region|window|all]" >&2
        exit 1
        ;;
esac

wl-copy --type image/png < "$FILE"
notify-send -c screenshot -i "$FILE" "Screenshot saved" "$FILE — click the toast to annotate"
