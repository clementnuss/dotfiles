#!/bin/sh
# Drata evidence: unattended-update, transcript-style.

printf '========== Arch update / Drata evidence — %s ==========\n' "$(hostname)"

printf '$ date\n'; date

printf '$ systemctl is-enabled unattended-update.timer\n'
systemctl is-enabled unattended-update.timer

printf '$ systemctl list-timers --no-pager unattended-update.timer | head -3\n'
systemctl list-timers --no-pager unattended-update.timer | head -3

printf '$ journalctl -u unattended-update.service -n 6 --no-pager\n'
journalctl -u unattended-update.service -n 6 --no-pager

printf '$ checkupdates | wc -l   # pending right now\n'
checkupdates | wc -l

printf '===========================================================\n'
