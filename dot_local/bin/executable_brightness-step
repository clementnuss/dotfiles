#!/bin/sh
# brightness-step up|down: internal panel (floored at 10%) + DDC monitor via ddcutil-service

SVC='com.ddcutil.DdcutilService'
OBJ='/com/ddcutil/DdcutilObject'
IFACE='com.ddcutil.DdcutilInterface'

case "$1" in
  up)   op='+' ;;
  down) op='-' ;;
  *) echo "usage: brightness-step up|down" >&2; exit 1 ;;
esac

cur=$(cat /sys/class/backlight/*/brightness 2>/dev/null | head -1)
max=$(cat /sys/class/backlight/*/max_brightness 2>/dev/null | head -1)
if [ -n "$cur" ] && [ -n "$max" ] && [ "$max" -gt 0 ] 2>/dev/null; then
    step=$((max / 20))
    floor=$((max / 10))
    new=$((cur ${op} step))
    [ "$new" -lt "$floor" ] && new=$floor
    [ "$new" -gt "$max" ] && new=$max
    brightnessctl -q -c backlight set "$new"
fi

# busctl exits 0 on daemon errors: check the reply status (2nd-to-last field).
# A stale display map (resume, replug) fails every call: Detect once and retry.
getvcp() {
    out=$(busctl --user call "$SVC" "$OBJ" "$IFACE" GetVcp isyu 1 "" 0x10 0 2>/dev/null) || return 1
    cur=$(printf '%s\n' "$out" | awk '{print $2}')
    max=$(printf '%s\n' "$out" | awk '{print $3}')
    status=$(printf '%s\n' "$out" | awk '{print $(NF-1)}')
    [ "${status:-1}" -eq 0 ] 2>/dev/null && [ "$max" -gt 0 ] 2>/dev/null
}

if ! getvcp; then
    busctl --user call "$SVC" "$OBJ" "$IFACE" Detect u 0 >/dev/null 2>&1
    getvcp || exit 0
fi
new=$((cur ${op} 5))
[ "$new" -lt 0 ] && new=0
[ "$new" -gt "$max" ] && new=$max
busctl --user call "$SVC" "$OBJ" "$IFACE" SetVcp isyqu 1 "" 0x10 "$new" 4 >/dev/null 2>&1
