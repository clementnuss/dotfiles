#!/usr/bin/env python3
"""cliphist-redact - drop password-like entries from the cliphist history.

A history entry is deleted when its content matches ANY of:
  R1  a known token shape:  -----BEGIN (keys), eyJ... (JWT), "Bearer ",
      ghp_/gho_/github_pat_/sk-/xox[bp]-/AKIA (API keys), ssh-rsa/ssh-ed25519
  R2  pure hex, 16+ chars (tokens, hashes, secret codes)
  R3  pure digits, 6+ chars (OTP / 2FA codes)
  R4  one long base64-ish blob, 24+ chars of [A-Za-z0-9+/=_-] and nothing else
  R5  the "generated password" shape: no whitespace, 12+ chars, 3+ character
      classes (upper/lower/digit/symbol), no 5-letter lowercase run (kills
      word-y prose/URL false-positives), 40%+ letters (version strings
      like v1.2.3-rc4 are digit-heavy and survive), and 70%+ distinct chars

Everything else is kept: prose has spaces, URLs have :// and word runs,
short strings are too risky to judge.

--min-age SECONDS keeps a grace window: secret-looking entries younger than
SECONDS survive. Needs cliphist with entry metadata (`list -fields
id,timestamp`; merged upstream Sep 2026, unreleased as of v0.7.0). When the
installed cliphist lacks it, --min-age is ignored with a warning and the run
deletes unconditionally. Entries with unknown age (stored before metadata
existed) count as old. The support probe runs against a scratch DB, never
the real one - v0.7.0 ignores unknown flags (a bare `cliphist wipe -h` wipes
everything), so live-DB probing is off-limits.

Known limits (accepted): passwords made of readable words survive R5
(the word-run guard protects prose from them), and copied 40-char git
SHAs die to R2. Use --dry-run to preview before deleting.

Usage: cliphist-redact [--min-age SECONDS] [--dry-run]
"""

import os
import re
import subprocess
import sys
import tempfile
import time

# cliphist-next is built from upstream master (unreleased entry-metadata work:
# `list -fields id,timestamp`, required by --min-age). Delete the file once the
# distro cliphist ships >= v0.8 and the fallback takes over seamlessly.
CLIPHIST_NEXT = "/home/cjmnuss/.local/bin/cliphist-next"
CLIPHIST = CLIPHIST_NEXT if os.path.exists(CLIPHIST_NEXT) else "cliphist"

TOKEN = re.compile(
    r"-----BEGIN|eyJ[A-Za-z0-9_-]{10,}|Bearer |ghp_|gho_|github_pat_|"
    r"sk-|xox[bp]-|AKIA|ssh-rsa |ssh-ed25519 "
)
HEX16 = re.compile(r"[0-9a-fA-F]{16,}")
DIGITS6 = re.compile(r"[0-9]{6,}")
BLOB24 = re.compile(r"[A-Za-z0-9+/=_-]{24,}")


def is_secret(content: str) -> bool:
    if TOKEN.search(content):
        return True
    if HEX16.fullmatch(content):
        return True
    if DIGITS6.fullmatch(content):
        return True
    if BLOB24.fullmatch(content):
        return True
    # R5: generated-password shape
    if len(content) < 12 or re.search(r"\s", content):
        return False
    classes = sum(
        bool(re.search(p, content))
        for p in (r"[a-z]", r"[A-Z]", r"[0-9]", r"[^A-Za-z0-9]")
    )
    if classes < 3:
        return False
    if re.search(r"[a-z]{5}", content):  # word-like -> probably prose or a URL
        return False
    if not re.search(r"[A-Za-z]", content):  # digit/symbol-only -> dates, versions
        return False
    letters = len(re.findall(r"[A-Za-z]", content))
    if letters < 0.40 * len(content):  # digit-heavy -> version strings, dates
        return False
    return len(set(content)) >= 0.70 * len(content)


def timestamps_supported() -> bool:
    """Probe -fields support on a scratch DB; never touches the real one."""
    fd, path = tempfile.mkstemp(suffix=".db")
    os.close(fd)
    try:
        subprocess.run(
            [CLIPHIST, "-db-path", path, "store"],
            input="capability probe\n",
            text=True,
            capture_output=True,
            check=True,
        )
        out = subprocess.run(
            [CLIPHIST, "-db-path", path, "list", "-fields", "id,timestamp"],
            capture_output=True,
            text=True,
        ).stdout.strip()
        # v0.8+ prints "id<TAB>unix-seconds"; v0.7.0 ignores -fields and
        # prints the default id,preview line instead.
        return re.fullmatch(r"\d+\t\d+", out) is not None
    finally:
        os.unlink(path)


def entry_ages() -> dict:
    """id -> unix ts (int), or None for entries stored before metadata."""
    out = subprocess.run(
        [CLIPHIST, "list", "-fields", "id,timestamp"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    ages = {}
    for line in out.splitlines():
        if not line:
            continue
        id_, _, ts = line.partition("\t")
        ages[id_] = int(ts) if ts.isdigit() else None
    return ages


def main() -> int:
    args = sys.argv[1:]
    dry_run = "--dry-run" in args
    min_age = 0
    if "--min-age" in args:
        min_age = int(args[args.index("--min-age") + 1])
        if not timestamps_supported():
            print(
                f"warning: cliphist lacks list -fields/timestamps; "
                f"--min-age {min_age} ignored, deleting unconditionally"
            )
            min_age = 0

    listing = subprocess.run(
        [CLIPHIST, "list"], capture_output=True, text=True, check=True
    ).stdout.splitlines()
    listing = [line for line in listing if line]

    if min_age > 0:
        ages = entry_ages()
        now = time.time()

        def too_old(entry_id: str) -> bool:
            ts = ages.get(entry_id)
            return ts is None or (now - ts) > min_age  # unknown age counts as old

        doomed = [
            line
            for line in listing
            if is_secret(line.split("\t", 1)[-1])
            and too_old(line.split("\t", 1)[0])
        ]
    else:
        doomed = [line for line in listing if is_secret(line.split("\t", 1)[-1])]

    for line in doomed:
        print("DEL", line[:100])
    print(f"{len(listing)} entries, {len(doomed)} look like secrets")

    if not doomed:
        return 0
    if dry_run:
        print("(dry run - nothing deleted; re-run without --dry-run)")
        return 0

    subprocess.run(
        [CLIPHIST, "delete"],
        input="\n".join(doomed) + "\n",
        text=True,
        check=True,
    )
    print(f"deleted {len(doomed)} entries")
    return 0


if __name__ == "__main__":
    sys.exit(main())